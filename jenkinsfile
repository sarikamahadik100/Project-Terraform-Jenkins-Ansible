pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-key')
        AWS_DEFAULT_REGION = 'us-east-1'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sarikamahadik100/Project-Terraform-Jenkins-Ansible.git'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform validate'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh 'terraform plan'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve'
            }
        }

       stage('Wait for EC2') {
            steps {
                echo 'Waiting for EC2 instances to boot...'
                sh 'sleep 60'
            }
        }

        stage('Build Application') {
            steps {
                dir('AddressBook') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Copy WAR to Ansible') {
            steps {
                sh '''
                cp AddressBook/target/*.war ansible/files/
                '''
            }
        }

        stage('Run Ansible') {
            steps {
                sh '''
                ansible-playbook \
                -i ansible/inventory \
                ansible/playbook.yml
                '''
            }
        }


        stage('Destroy Confirmation') {
            steps {
                input 'Destroy Terraform resources?'
            }
        }

        stage('Terraform Destroy') {
            steps {
                sh 'terraform destroy -auto-approve'
            }
        }
    }
}
