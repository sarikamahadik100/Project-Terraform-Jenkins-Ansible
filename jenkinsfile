pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-key')
        AWS_DEFAULT_REGION = 'us-east-1'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sarikamahadik100/Project-Terraform-Jenkins-Ansible.git'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform validate'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh 'terraform plan'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve'
            }
        }

stage('Generate Inventory') {
    steps {
        sh '''
        mkdir -p ansible

        echo "[webservers]" > ansible/inventory

        terraform output -json remote_server_ips | \
        jq -r '.[]' | while read ip
        do
          echo "$ip ansible_user=ubuntu ansible_ssh_private_key_file=/home/ubuntu/.ssh/id_ed25519" >> ansible/inventory
        done

        cat ansible/inventory
        '''
    }
}
       stage('Wait for EC2') {
            steps {
                echo 'Waiting for EC2 instances to boot...'
                sh 'sleep 60'
            }
        }

stage('Build Application') {
    steps {
        sh '''
        echo "Searching for pom.xml..."
        find . -name pom.xml

        mvn clean package -f $(find . -name pom.xml | head -1)
        '''
    }
}

stage('Copy WAR to Ansible') {
    steps {
        sh '''
        mkdir -p ansible/files

        cp $(find . -path "./ansible" -prune -o -name "*.war" -print | head -1) ansible/files/

        ls -l ansible/files/
        '''
    }
}

stage('Run Ansible') {
    steps {
        sh '''
        CONTROL_SERVER_IP=$(terraform output -raw control_server_ip)

        echo "Running Ansible on Control Server: $CONTROL_SERVER_IP"

        mkdir -p ~/.ssh

        ssh-keyscan -H $CONTROL_SERVER_IP >> ~/.ssh/known_hosts

      scp -o StrictHostKeyChecking=no -r ansible ubuntu@${CONTROL_SERVER_IP}:/home/ubuntu/

ssh ubuntu@${CONTROL_SERVER_IP} '
cd /home/ubuntu/ansible &&
ANSIBLE_HOST_KEY_CHECKING=False ansible-playbook -i inventory playbook.yml
'
        "
        '''
    }
}


        stage('Destroy Confirmation') {
            steps {
                input 'Destroy Terraform resources?'
            }
        }

        stage('Terraform Destroy') {
            steps {
                sh 'terraform destroy -auto-approve'
            }
        }
    }
}
